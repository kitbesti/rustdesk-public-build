GITHUB_OWNER=your-github-username
GITHUB_OWNER_TYPE=user
GITHUB_REPO=rustdesk-public-build
GITHUB_BRANCH=main

# GitHub no longer supports account passwords for Git/API operations.
# Fill a classic PAT here. The stable choice is: repo + workflow.
GITHUB_TOKEN=github_pat_xxx

# Optional Git commit identity for the exported public build repo.
GIT_AUTHOR_NAME=RustDesk Public Build Bot
GIT_AUTHOR_EMAIL=public-build-bot@users.noreply.github.com

# This repo is intended to be disposable. FORCE_PUSH=1 updates it in place.
FORCE_PUSH=1

# Default build matrix. 1 means enabled, 0 means disabled.
USE_LOCAL_BRIDGE=1
WINDOWS_AMD64=1
MACOS_AMD64=1
MACOS_ARM64=1
LINUX_AMD64=1
LINUX_ARM64=1
ANDROID_ARM64=1
IOS_UNSIGNED=1

REPO_DESCRIPTION=Temporary public build repo for multi-platform RustDesk builds
