set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(CMAKE_C_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_CXX_COMPILER aarch64-linux-gnu-g++)
set(CMAKE_ASM_COMPILER aarch64-linux-gnu-gcc)
set(CMAKE_AR aarch64-linux-gnu-ar)
set(CMAKE_RANLIB aarch64-linux-gnu-ranlib)

if(DEFINED ENV{RD_SYSROOT} AND NOT "$ENV{RD_SYSROOT}" STREQUAL "")
  set(CMAKE_SYSROOT "$ENV{RD_SYSROOT}")
  set(CMAKE_FIND_ROOT_PATH "$ENV{RD_SYSROOT}")
  set(_RD_SYSROOT_LINK_FLAGS "--sysroot=${CMAKE_SYSROOT} -Wl,-rpath-link,${CMAKE_SYSROOT}/lib/aarch64-linux-gnu -Wl,-rpath-link,${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu")
  string(APPEND CMAKE_C_FLAGS_INIT " --sysroot=${CMAKE_SYSROOT}")
  string(APPEND CMAKE_CXX_FLAGS_INIT " --sysroot=${CMAKE_SYSROOT}")
  string(APPEND CMAKE_ASM_FLAGS_INIT " --sysroot=${CMAKE_SYSROOT}")
  string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " ${_RD_SYSROOT_LINK_FLAGS}")
  string(APPEND CMAKE_SHARED_LINKER_FLAGS_INIT " ${_RD_SYSROOT_LINK_FLAGS}")
  string(APPEND CMAKE_MODULE_LINKER_FLAGS_INIT " ${_RD_SYSROOT_LINK_FLAGS}")
endif()

set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
